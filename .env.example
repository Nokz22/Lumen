# Copy to .env and adjust locally. Never commit a real .env.
#
# Two audiences here. The DEVELOPMENT block is everything `docker compose up`
# needs to bring up Postgres and RabbitMQ so the apps can run from an IDE. The
# PRODUCTION block is what docker-compose.prod.yml requires; the prod profile
# refuses to start if any of it is missing, and names what is missing.

# =============================================================================
# DEVELOPMENT
# =============================================================================

# --- PostgreSQL ---
POSTGRES_DB=lumen
POSTGRES_USER=lumen
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=lumen
RABBITMQ_DEFAULT_PASS=changeme
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Companion LLM (optional; defaults to the mock client, never the real API) ---
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_TIMEOUT_SECONDS=20

# =============================================================================
# PRODUCTION  (docker compose -f docker-compose.prod.yml up)
# =============================================================================
#
# The two secrets below have development defaults committed in
# backend/src/main/resources/application.yml. Those values are in this
# repository's history permanently — anyone who can read the repo can forge
# tokens signed with that JWT secret, and read anything encrypted with that key.
# The prod profile refuses to start if it finds either of them, so generate new
# ones:
#
#   JWT_SECRET      openssl rand -base64 48
#   ENCRYPTION_KEY  openssl rand -base64 32     (AES-256: must decode to 32 bytes)
#
JWT_SECRET=
ENCRYPTION_KEY=

# Origin the browser loads the frontend from. Used for CORS and for the
# WebSocket handshake, so a mismatch breaks the live dashboard, not just fetches.
CORS_ALLOWED_ORIGINS=

# Public URL of the backend API. Vite inlines this at BUILD time, so changing it
# means rebuilding the frontend image — restarting it will not pick up a new value.
VITE_API_BASE_URL=

# Host port the frontend is published on.
FRONTEND_PORT=8080

# --- Running the backend outside compose ---
# Compose derives these from POSTGRES_*/RABBITMQ_* above, so they are only needed
# when running the jar directly (Render, Railway, a plain VM).
#
# Note the name: DATABASE_JDBC_URL, not DATABASE_URL. Render, Railway and Heroku
# inject a DATABASE_URL of their own in postgres://user:pass@host/db form, which
# is not a JDBC URL and which the driver cannot parse. Convert it:
#
#   jdbc:postgresql://HOST:5432/DBNAME
#
# Or give the parts instead and let the application assemble it — which is what
# render.yaml does, because a platform blueprint can wire host/port/name straight
# from its managed database but cannot build a string out of them.
#
#DATABASE_JDBC_URL=jdbc:postgresql://localhost:5432/lumen
#DATABASE_HOST=localhost
#DATABASE_NAME=lumen
#DATABASE_USERNAME=lumen
#DATABASE_PASSWORD=
#RABBITMQ_HOST=localhost
#RABBITMQ_PORT=5672
#RABBITMQ_USERNAME=lumen
#RABBITMQ_PASSWORD=
